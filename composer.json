{
    "name": "blog-platform/test",
    "description": "Senior PHP Test Project",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "smarty/smarty": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/Helpers.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
